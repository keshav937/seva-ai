# GEMINI_API_KEY: Optional Gemini AI Civic Intelligence Engine key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted (used for SOS tracking links).
APP_URL="http://localhost:3000"

# SEVA_ENV_MODE: "development" (shows clearly labelled Demo/Testing OTP on site) or "production" (strictly sends via SMS/Email providers without exposing OTPs)
SEVA_ENV_MODE="development"

# SESSION_SECRET: Strong random secret key for signing session cookies and verification proofs
SESSION_SECRET="replace-with-strong-random-secret"

# SOS_SMS_INTERVAL_SECONDS: Minimum interval in seconds between periodic SOS live-location SMS updates (default 120)
SOS_SMS_INTERVAL_SECONDS="120"

# SMS Providers (Twilio or MSG91) - leave blank if running in Demo Mode
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_TEMPLATE_ID=""

# Email Providers (Resend or SendGrid) - leave blank if running in Demo Mode
RESEND_API_KEY=""
RESEND_FROM_EMAIL="SEVA AI <noreply@seva-ai.in>"
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="noreply@seva-ai.in"
